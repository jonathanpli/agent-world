{
  "permissions": { "allow": ["Bash(git status:*)"], "deny": ["Read(./.env)"] },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "/Users/test/.claude/hooks/rtk-rewrite.sh" }] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "bash /Users/test/.claude/hooks/memory-completion-guard.sh", "timeout": 10 }] }
    ]
  }
}
